<table width="100%" cellspacing="1" cellpadding="0" class="ipbtable">
  <tr>
    <td class="row2" width="146">{author}</td>
    <td class="row2"><span class="postdetails">
      <div style="float:left;"><img src="{THEME}/forum/images/to_post_off.gif" width="8" height="9" border="0" alt="" /> {post-date}</div>
      <div align="right">{ip} Сообщение #{post_id}{selected}</div>
      </span></td>
  </tr>
  <tr>
    <td valign="top" class="post2"><span class="postdetails"> <img src="{foto}" border="0" alt="" /><br />
      <br />
      {rank-title}<br />
      {rank-image}<br />
	  Репутация: {reputation}<br />
      Группа: {group-name}<br />
      Сообщений: {post-num}<br />
      Регистрация: {registration}<br />
      ICQ:{sticq}{icq}<br />[warn]<br />
      Предупреждения:<br />
      {warn}[/warn]</span></td>
    <td valign="top" class="post2"><span class="postcolor">{text}</span>{edit-info}[signature]<br />
      --------------------<br />
      {signature}[/signature]</td>
  </tr>
  <tr>
    <td class="formbuttonrow" nowrap="nowrap"><div align="left"><a href="#posts"><img src="{THEME}/forum/images/dlet_up.gif" width="24" height="21" border="0" alt="Перейти в начало страницы" /></a> [report]<img src="{THEME}/forum/images/dlet_report.gif" width="72" height="21" border="0" alt="Сообщить о сообщении" />[/report]</div></td>
    <td class="formbuttonrow" nowrap="nowrap"><div align="right">[fast]<img src="{THEME}/forum/images/dlet_mq_add.gif" width="74" height="21" border="0" alt="Вставка цитаты" />[/fast] [post-edit]<img src="{THEME}/forum/images/dlet_edit.gif" width="89" height="21" border="0" alt="Редактировать сообщение" />[/post-edit] [post-del]<img src="{THEME}/forum/images/dlet_delete.gif" width="80" height="21" border="0" alt="Удалить сообщение" />[/post-del]</div></td>
  </tr>
  <tr>
    <td colspan="2" class="catend"><!-- DLE Forum --></td>
  </tr>
</table>