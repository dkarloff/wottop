    .teaser_block * {
        margin: 0;
        padding: 0;
        cursor: pointer;
        background: transparent none repeat scroll 0 0;
        clear: none;
        clip: rect(auto, auto, auto, auto);
        font-size: 100%;
        font-style: normal;
        font-variant: normal;
        font-weight: normal;
        height: auto;
        letter-spacing: normal;
        position: static;
        text-align: left;
        text-indent: 0;
        text-transform: none;
        vertical-align: baseline;
        visibility: visible;
        white-space: normal;
        width: auto;
        word-spacing: normal;
        z-index: auto;
        word-wrap: break-word;
    }
    .teaser_block {
        overflow: hidden;
        border: 1px solid #c0c0c0;
        background-color: #ffffff;
        box-sizing: border-box;
        -moz-box-sizing: border-box;
        -webkit-box-sizing: border-box;
        border-radius: 3px;
        -webkit-border-radius: 3px;
        -moz-border-radius: 3px;
    }
    .teaser_block .teaser_list {
        white-space: nowrap;
        font-size: 0;
    }
    .teaser_block .teaser_item {
        white-space: normal;
        font-size: 14px;
        height: 100%;
        box-sizing: border-box;
        -moz-box-sizing: border-box;
        -webkit-box-sizing: border-box;
        position: relative;
    }
    .teaser_block .teaser_item:hover {
        background-color: #fcfbf7;
    }
    .teaser_block .teaser_item:hover .teaser_item_block a {
        color: #ff0000;
        text-decoration: none;
    }
    .teaser_block .teaser_item_block {
        color: #000000;
        font-family: Arial, Helvetica, Tahoma, Verdana, Sans-Serif;
        font-size: 14px;
        text-align: left !important;
        line-height: 130%;
        height: 100%;
        box-sizing: border-box;
        -moz-box-sizing: border-box;
        -webkit-box-sizing: border-box;
    }
    .teaser_block .teaser_item_block img {
        width: 80px;
        border: 0;
        position: absolute;
        padding: 3px;
        box-sizing: border-box;
        -moz-box-sizing: border-box;
        -webkit-box-sizing: border-box;
        top: 0;
        left: 5px;
        margin: auto;
        height: 100%;
        max-height: 80px;
    }
    .teaser_block .teaser_item_block a {
        color: #0645ad;
        text-decoration: underline;
    }
    .teaser_block .teaser_item_block a:hover {
        color: #ff0000;
    }
    .teaser_block .teaser_list_small  .teaser_item_block {
        padding: 2px 2px 2px 70px !important;
        font-size: 11px;
        line-height: 110%;
    }
    .teaser_block .teaser_list_small .teaser_item_block img {
        width: auto;
        max-width: 80px;
    }
    .teaser_block .teaser_list_hor {
        height: 100%;
    }
    .teaser_block .teaser_list_hor > .teaser_item {
        display: inline-block;
        width: 50%;
        float: left;
    }
    .teaser_block .teaser_list_hor .teaser_item_block, .teaser_block .teaser_list_square .teaser_item_block {
        padding: 5px 5px 5px 90px;
    }
    .teaser_block .teaser_list_hor .teaser_item_block img, .teaser_block .teaser_list_square .teaser_item_block img {
        bottom: 0;
    }
    .teaser_block .teaser_list_hor > .teaser_item:last-child {
        border-left: 1px dotted silver;
    }
    .teaser_block .teaser_list_square, .teaser_list_ver {
        height: 50%;
    }
    .teaser_block .teaser_list_square > .teaser_item:last-child, .teaser_block .teaser_list_ver > .teaser_item:last-child {
        border-top: 1px dotted silver;
    }
    .teaser_block .teaser_list_ver .teaser_item_block {
        padding: 100px 10px 10px 10px;
    }
    .teaser_block .teaser_list_ver .teaser_item_block img {
        top: 10px;
        right: 0;
    }
    .teaser_block.teaser_block_240x400 {
        width: 240px;
        height: 400px;
    }
    .teaser_block.teaser_block_728x90 {
        width: 728px;
        height: 90px;
    }
    .teaser_block.teaser_block_300x250 {
        width: 300px;
        height: 250px;
    }
    .teaser_block.teaser_block_468x60 {
        width: 468px;
        height: 60px;
    }
    .teaser_block.teaser_block_160x600 {
        width: 160px;
        height: 600px;
    }
</style>";s:16:"__sape_new_url__";s:20:"<!--1881732571026-->";s:26:"__sape_new_teasers_block__";s:21:"<!--t1881732571026-->";s:16:"__sape_charset__";s:12:"windows-1251";s:15:"__last_update__";i:1519005122;s:14:"__multi_site__";b:0;s:21:"__fetch_remote_type__";s:17:"file_get_contents";s:15:"__ignore_case__";b:0;s:15:"__php_version__";s:16:"5.4.45-0+deb7u11";s:19:"__server_software__";s:22:"Apache/2.2.22 (Debian)";}